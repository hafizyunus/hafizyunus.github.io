---
// A link from site.yaml → socials. `url: email` links to your (obfuscated) email via <Email>.
import Email from './Email.astro';

interface Props {
  label: string;
  href: string;
  class?: string;
}

const { label, href, class: className } = Astro.props;
---

{
  href === 'email' ? (
    <Email label={label} class={className} />
  ) : (
    <a href={href} class={className} rel="me">
      {label}
    </a>
  )
}
