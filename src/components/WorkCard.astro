---
import Doodle from './Doodle.astro';
import { formatRange, url, type Work } from '../lib/utils';

interface Props {
  item: Work;
}

const { item } = Astro.props;
const { data } = item;
---

<a
  href={url(`/work/${item.id}/`)}
  class="group flex h-full flex-col rounded-lg border border-rule p-5 no-underline transition-colors hover:border-accent/50"
>
  {data.doodle && <Doodle name={data.doodle} size={64} class="mb-3" />}
  <p class="text-xs text-muted">{data.org} · {formatRange(data.start, data.end)}</p>
  <h3 class="mt-1 font-serif text-xl leading-snug group-hover:text-accent">{data.title}</h3>
  <p class="mt-2 text-sm leading-relaxed text-ink/75">{data.summary}</p>
  {
    data.metrics.length > 0 && (
      <ul class="mt-auto flex flex-wrap gap-x-4 gap-y-1 pt-4 text-xs text-muted">
        {data.metrics.map((m) => (
          <li>
            <span class="font-mono text-accent">{m.value}</span> {m.label}
          </li>
        ))}
      </ul>
    )
  }
</a>
