---
// Email link that scrapers can't read from the HTML.
// Visible text: "name [at] gmail [dot] com" (or a custom label).
// Uses person.emailEncoded from site.yaml; the mailto: link is only built in the browser.
import { config, decodeEmail } from '../lib/site';
import { url } from '../lib/utils';

interface Props {
  label?: string; // show this instead of the obfuscated address, e.g. "Email"
  class?: string;
}

const { label, class: className } = Astro.props;
const encoded = config.person.emailEncoded;
const [user, domain] = decodeEmail(encoded).split('@');
const shown = label ?? `${user} [at] ${domain.replaceAll('.', ' [dot] ')}`;
---

<a href={url('/contact/')} data-email={encoded} class:list={['js-email', className]}>{shown}</a>

<script>
  for (const link of document.querySelectorAll<HTMLAnchorElement>('a.js-email[data-email]')) {
    link.href = `mailto:${[...atob(link.dataset.email ?? '')].reverse().join('')}`;
  }
</script>
