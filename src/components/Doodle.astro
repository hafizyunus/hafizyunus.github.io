---
// Shows a hand-drawn doodle from src/assets/doodles/<name>.svg.
// If the file doesn't exist yet, a dashed placeholder is shown while developing,
// and nothing is shown on the live site. See docs/design/DOODLES.md
interface Props {
  name?: string;
  size?: number; // display width in px
  class?: string;
}

const { name, size = 200, class: className = '' } = Astro.props;

const files = import.meta.glob<string>('/src/assets/doodles/*.svg', {
  eager: true,
  query: '?url',
  import: 'default',
});
const src = name ? files[`/src/assets/doodles/${name}.svg`] : undefined;
const showPlaceholder = !src && name && import.meta.env.DEV;
---

{
  src && (
    <img src={src} alt="" aria-hidden="true" width={size} class:list={['select-none', className]} style={`width:${size}px;height:auto`} />
  )
}
{
  showPlaceholder && (
    <div
      aria-hidden="true"
      class:list={['grid place-items-center rounded-lg border border-dashed border-rule text-xs text-muted', className]}
      style={`width:${size}px;height:${Math.round(size * 0.8)}px`}
    >
      doodle: {name}
    </div>
  )
}
