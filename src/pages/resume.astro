---
// Web resume built from the same content files as the rest of the site.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Email from '../components/Email.astro';
import SkillLink from '../components/SkillLink.astro';
import { config } from '../lib/site';
import { byPosition, formatDate, formatRange, getWorkByCategory, url } from '../lib/utils';

const groups = await getWorkByCategory();
const education = (await getCollection('education')).sort(byPosition);
const skills = (await getCollection('skills')).sort(byPosition);
const awards = (await getCollection('awards')).sort(byPosition);
const workIds = new Set(groups.flatMap((g) => g.items.map((w) => w.id)));
for (const { id, data } of awards) {
  if (data.work && !workIds.has(data.work)) {
    throw new Error(`content/awards.yaml (${id}): work "${data.work}" isn't a file in content/work/`);
  }
}
const { person } = config;
// File name used when someone downloads the PDF, e.g. Hafiz_Yunus_Kalathil_Resume.pdf
const pdfName = `${person.fullName.replaceAll(' ', '_')}_Resume.pdf`;
---

<Base title="Resume" description={`Resume of ${person.fullName}, ${person.headline}.`} doodle="resume">
  <header class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="font-serif text-4xl tracking-tight">{person.fullName}</h1>
      <p class="mt-2 flex flex-wrap gap-x-3 text-sm text-muted">
        <span>{person.headline}</span>
        <span>{person.location}</span>
        <Email class="hover:text-accent" />
      </p>
    </div>
    <div class="no-print flex gap-4 text-sm">
      {
        person.resumePdf && (
          <a href={url(person.resumePdf)} class="text-accent underline underline-offset-4" download={pdfName}>
            Download PDF
          </a>
        )
      }
      <button type="button" onclick="window.print()" class="text-muted hover:text-accent">Print</button>
    </div>
  </header>

  <section class="mt-12">
    <h2 class="border-b border-rule pb-1 text-xs font-medium uppercase tracking-widest text-muted">Education</h2>
    {
      education.map(({ data }) => (
        <div class="mt-4 flex flex-wrap justify-between gap-x-4">
          <div>
            <p class="font-medium">{data.school}</p>
            <p class="text-sm text-ink/75">
              {data.degree}
              {data.grade && ` · ${data.grade}`}
            </p>
          </div>
          <p class="text-sm text-muted">
            {data.start} – {data.end}
            {data.location && ` · ${data.location}`}
          </p>
        </div>
      ))
    }
  </section>

  <section class="mt-10">
    <h2 class="flex justify-between border-b border-rule pb-1 text-xs font-medium uppercase tracking-widest text-muted">
      Skills
      <a href={url('/skills/')} class="no-print normal-case tracking-normal hover:text-accent">where I've used them →</a>
    </h2>
    <dl class="mt-4 space-y-2 text-sm">
      {
        skills.map(({ data }) => (
          <div class="sm:flex sm:gap-4">
            <dt class="shrink-0 font-medium sm:w-40">{data.label}</dt>
            <dd class="text-ink/75">
              {data.items.map((name, i) => (
                <>
                  {i > 0 && ', '}
                  <SkillLink name={name} />
                </>
              ))}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  {
    groups.map((group) => (
      <section class="mt-10">
        <h2 class="border-b border-rule pb-1 text-xs font-medium uppercase tracking-widest text-muted">{group.label}</h2>
        {group.items.map((item) => (
          <div class="mt-5">
            <div class="flex flex-wrap justify-between gap-x-4">
              <p class="font-medium">
                <a href={url(`/work/${item.id}/`)} class="hover:text-accent">
                  {item.data.org}
                </a>
              </p>
              <p class="text-sm text-muted">{formatRange(item.data.start, item.data.end)}</p>
            </div>
            <p class="text-sm italic text-ink/75">
              {item.data.role}
              {item.data.location && ` · ${item.data.location}`}
            </p>
            <ul class="mt-2 list-disc space-y-1 pl-5 text-sm leading-relaxed">
              {item.data.highlights.map((h) => (
                <li>{h}</li>
              ))}
            </ul>
            <a href={url(`/work/${item.id}/`)} class="no-print mt-1 inline-block text-xs text-accent">
              read more →
            </a>
          </div>
        ))}
      </section>
    ))
  }

  {
    awards.length > 0 && (
      <section class="mt-10">
        <h2 class="border-b border-rule pb-1 text-xs font-medium uppercase tracking-widest text-muted">Awards & achievements</h2>
        <ul class="mt-4 space-y-3 text-sm">
          {awards.map(({ data }) => (
            <li class="flex flex-wrap justify-between gap-x-4">
              <div>
                <p class="font-medium">
                  {data.work ? (
                    <a href={url(`/work/${data.work}/`)} class="hover:text-accent">
                      {data.title}
                    </a>
                  ) : (
                    data.title
                  )}
                  {data.org && <span class="font-normal text-ink/75"> · {data.org}</span>}
                </p>
                {data.note && <p class="text-ink/75">{data.note}</p>}
              </div>
              <p class="text-muted">{formatDate(data.date)}</p>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>
