---
import Base from '../../layouts/Base.astro';
import WorkCard from '../../components/WorkCard.astro';
import { getWorkByCategory } from '../../lib/utils';

const groups = await getWorkByCategory();
---

<Base title="Work" description="Jobs, teams and projects, each with an in-depth write-up." doodle="work" wide>
  <h1 class="font-serif text-4xl tracking-tight">Work</h1>
  <p class="mt-3 max-w-[42rem] text-ink/75">
    Everything on my resume, in more depth. Pick one to read how the work was done.
  </p>

  {
    groups.map((group) => (
      <section class="mt-14">
        <h2 class="text-xs font-medium uppercase tracking-widest text-muted">{group.label}</h2>
        <ul class="mt-4 grid gap-4 sm:grid-cols-2">
          {group.items.map((item) => (
            <li>
              <WorkCard item={item} />
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Base>
