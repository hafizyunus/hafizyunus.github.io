---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import WorkCard from '../../components/WorkCard.astro';
import { getSkills, usageCount, type Skill } from '../../lib/skills';
import { formatMonth, url } from '../../lib/utils';

export async function getStaticPaths() {
  const skills = [...(await getSkills()).values()].filter((s) => usageCount(s) > 0);
  return skills.map((skill) => ({ params: { skill: skill.slug }, props: { skill } }));
}

interface Props {
  skill: Skill;
}

const { skill } = Astro.props;
const n = usageCount(skill);
---

<Base title={skill.name} description={`Where ${skill.name} was used: ${n} ${n === 1 ? 'item' : 'items'}.`} wide>
  <a href={url('/skills/')} class="no-print text-sm text-muted hover:text-accent">← skills</a>

  <header class="mt-8">
    {skill.group && <p class="text-xs font-medium uppercase tracking-widest text-muted">{skill.group}</p>}
    <h1 class="mt-2 font-serif text-4xl leading-tight tracking-tight">{skill.name}</h1>
    <p class="mt-3 text-ink/75">
      Used in {n} {n === 1 ? 'place' : 'places'}.
    </p>
  </header>

  {
    skill.work.length > 0 && (
      <section class="mt-10">
        <h2 class="text-xs font-medium uppercase tracking-widest text-muted">Work</h2>
        <ul class="mt-4 grid gap-4 sm:grid-cols-2">
          {skill.work.map((item) => (
            <li>
              <WorkCard item={item} />
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    skill.albums.length > 0 && (
      <section class="mt-12">
        <h2 class="text-xs font-medium uppercase tracking-widest text-muted">Photos</h2>
        <ul class="mt-4 grid gap-4 sm:grid-cols-3">
          {skill.albums.map(({ id, entry, photos, cover }) => (
            <li>
              <a href={url(`/gallery/${id}/`)} class="group block">
                <div class="aspect-[3/2] overflow-hidden rounded-lg bg-rule/50">
                  {cover && (
                    <Image src={cover.image} alt="" width={600} widths={[300, 600]} sizes="(min-width: 640px) 250px, 100vw" class="size-full object-cover" />
                  )}
                </div>
                <p class="mt-2 font-serif text-lg group-hover:text-accent">{entry.data.title}</p>
                <p class="text-xs text-muted">
                  {formatMonth(entry.data.date)} · {photos.length} photos
                </p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>
