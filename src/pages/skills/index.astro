---
import Base from '../../layouts/Base.astro';
import { getSkills, usageCount, type Skill } from '../../lib/skills';
import { url } from '../../lib/utils';

const skills = [...(await getSkills()).values()];

// skills.yaml groups first (in their written order), then everything else by how often it's used
const groupOrder: string[] = [];
for (const s of skills) if (s.group && !groupOrder.includes(s.group)) groupOrder.push(s.group);
const groups: { label: string; items: Skill[] }[] = groupOrder.map((label) => ({
  label,
  items: skills.filter((s) => s.group === label),
}));
const other = skills
  .filter((s) => !s.group && usageCount(s) > 0)
  .sort((a, b) => usageCount(b) - usageCount(a) || a.name.localeCompare(b.name));
if (other.length) groups.push({ label: 'Topics & methods', items: other });
---

<Base title="Skills" description="Skills and tools, and where each one was used." wide>
  <h1 class="font-serif text-4xl tracking-tight">Skills</h1>
  <p class="mt-3 max-w-[42rem] text-ink/75">Pick a skill to see the work where I used it.</p>

  {
    groups.map((group) => (
      <section class="mt-12">
        <h2 class="text-xs font-medium uppercase tracking-widest text-muted">{group.label}</h2>
        <ul class="mt-4 flex flex-wrap gap-2 text-sm">
          {group.items.map((s) => {
            const n = usageCount(s);
            return (
              <li>
                {n > 0 ? (
                  <a href={url(`/skills/${s.slug}/`)} class="skill-chip">
                    {s.name}
                    <span class="ml-1.5 text-xs text-muted">{n}</span>
                  </a>
                ) : (
                  <span class="skill-chip skill-chip--plain">{s.name}</span>
                )}
              </li>
            );
          })}
        </ul>
      </section>
    ))
  }
</Base>

<style>
  .skill-chip {
    display: inline-block;
    border: 1px solid var(--color-rule);
    border-radius: 999px;
    padding: 0.25rem 0.8rem;
  }
  a.skill-chip:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .skill-chip--plain {
    color: var(--color-muted);
    border-style: dashed;
  }
</style>
