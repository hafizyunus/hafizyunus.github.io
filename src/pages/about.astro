---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';

const page = await getEntry('pages', 'about');
if (!page) throw new Error('Missing content/pages/about.md');
const { Content } = await render(page);
---

<Base title={page.data.title} description={page.data.description} doodle="about">
  <h1 class="font-serif text-4xl tracking-tight">{page.data.title}</h1>
  <div class="prose mt-8">
    <Content />
  </div>
</Base>
